# 复制为仓库根目录的 .env 并填写本地值。不要提交 .env，不要把真实密码写进源码。

POSTGRES_DB=enterprise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 管理员账号只用于容器初始化和紧急维护，应用运行时不使用它。
BUSINESS_MIGRATOR_PASSWORD=
BUSINESS_APP_PASSWORD=
AGENT_MIGRATOR_PASSWORD=
AGENT_APP_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 设为 true 时，Python 进程启动并保持 PostgreSQL 连接池和 Redis 客户端。默认关闭，避免健康检查进程依赖数据库。
ENTERPRISE_INFRA_ENABLED=false
