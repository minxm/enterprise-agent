APP_NAME=Enterprise Agent Runtime
API_PREFIX=/api/v1

# 也可以不在这里重复填写，直接使用仓库根目录 .env。密码留空，不要提交真实值。
POSTGRES_DB=enterprise
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
AGENT_APP_USER=agent_app
AGENT_APP_PASSWORD=
AGENT_MIGRATOR_USER=agent_migrator
AGENT_MIGRATOR_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
ENTERPRISE_INFRA_ENABLED=false

# 与 Java AGENT_INTERNAL_TOKEN 使用同一个值。留空则内部接口拒绝所有请求。
AGENT_INTERNAL_TOKEN=

# Embedding。API Key 留空，不要提交真实值。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# 对话模型。与 Embedding 模型分开配置，API Key 仍使用上面的 SILICONFLOW_API_KEY。
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_TOKENS=1024
